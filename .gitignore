# --- OS ---
.DS_Store

# --- Secrets ---
# Never commit real credentials. .env.example (no real values) is tracked.
backend/.env
.env
.env.local

# --- Python / backend ---
backend/.venv/
**/__pycache__/
*.py[cod]
backend/.pytest_cache/
backend/*.egg-info/
backend/logs/

# Runtime data: user uploads and generated exports. Not source, not meant
# to be versioned — regenerated by using the app.
backend/uploads/

# --- Node / frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
