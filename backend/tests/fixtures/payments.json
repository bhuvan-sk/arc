  "facts": [
    {
      "id": "fact_001",
      "subject_kind": "node",
      "subject_id": "pg",
      "layer": "data",
      "layer_index": 0,
      "category": "consistency",
      "statement": "All order writes land on a single Postgres primary.",
      "tradeoff": "One writer gives serialisable ordering free, but the primary is a single point of write availability.",
      "ddia_axis": "reliability",
      "provenance": {
        "origin": "stated",
        "source": {"kind": "upload", "file_id": "f_01", "locator": "page 1, architecture notes"},
        "confidence": 0.95
      }
    },
    {
      "id": "fact_002",
      "subject_kind": "connection",
      "subject_id": "e_pg_cdc",
      "layer": "data",
      "layer_index": 0,
      "category": "availability",
      "statement": "Logical replication publishes row-level changes to the change stream.",
      "tradeoff": "Row-level CDC decouples analytics from the primary write path, but introduces replication lag that makes warehoused data eventually consistent.",
      "ddia_axis": "scalability",
      "provenance": {
        "origin": "stated",
        "source": {"kind": "upload", "file_id": "f_01", "locator": "page 1, replication arrow"},
        "confidence": 0.9
      }
    },
    {
      "id": "fact_003",
      "subject_kind": "node",
      "subject_id": "wh",
      "layer": "data",
      "layer_index": 0,
      "category": "scale",
      "statement": "Snowflake is a read-only consumer receiving streamed writes from the change stream.",
      "tradeoff": "Separating analytical reads from transactional writes eliminates OLAP query contention on the primary, but the warehouse has no write-path consistency guarantee.",
      "ddia_axis": "scalability",
      "provenance": {
        "origin": "stated",
        "source": {"kind": "upload", "file_id": "f_01", "locator": "page 1, Snowflake box"},
        "confidence": 0.9
      }
    },
    {
      "id": "fact_004",
      "subject_kind": "node",
      "subject_id": "gw",
      "layer": "api",
      "layer_index": 1,
      "category": "security",
      "statement": "The Edge Gateway is the sole public surface, handling auth and rate limiting before any service sees a request.",
      "tradeoff": "A single ingress surface is easier to audit and rate-limit, but it becomes a bottleneck and single point of failure if not horizontally scaled.",
      "ddia_axis": "reliability",
      "provenance": {
        "origin": "stated",
        "source": {"kind": "upload", "file_id": "f_01", "locator": "page 1, Edge Gateway box"},
        "confidence": 0.95
      }
    },
    {
      "id": "fact_005",
      "subject_kind": "node",
      "subject_id": "ledger",
      "layer": "api",
      "layer_index": 1,
      "category": "consistency",
      "statement": "Ledger API is the only service holding write credentials for Postgres.",
      "tradeoff": "Centralised write ownership prevents split-brain and makes consistency easier to reason about, but Ledger becomes a chokepoint for all write throughput.",
      "ddia_axis": "maintainability",
      "provenance": {
        "origin": "stated",
        "source": {"kind": "upload", "file_id": "f_01", "locator": "page 1, architecture notes Ledger owns DB creds"},
        "confidence": 0.9
      }
