      "subject_kind": "connection",
      "subject_id": "e_ledger_stripe",
      "layer": "api",
      "layer_index": 1,
      "category": "availability",
      "statement": "Settlement calls to Stripe are idempotent and retried out-of-band.",
      "tradeoff": "Idempotent retries prevent duplicate charges on provider timeout, but require reliable idempotency key storage and complicate failure recovery logic.",
      "ddia_axis": "reliability",
      "provenance": {
