{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Narrative",
  "type": "object",
  "additionalProperties": false,
  "required": ["kicker", "title", "body", "items", "chat_seed"],
  "properties": {
    "kicker": { "type": "string" },
    "title": { "type": "string" },
    "body": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "title", "sub"],
        "properties": {
          "node_id": { "type": "string" },
          "title": { "type": "string" },
          "sub": { "type": "string" }
        }
      }
    },
    "chat_seed": { "type": "string" }
  }
}
