MONGO_URI=mongodb://localhost:27017
MONGO_DB=arch_explainer
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
PDF_RASTER_DPI=180
ENABLE_MODE_B=false

OPENAI_API_KEY=

MODEL_DEFAULT=gpt-4o-mini
