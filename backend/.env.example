# Gemini Live — real-time voice chat (WebSocket bridge in api/routes_live.py).
# Get a key at https://aistudio.google.com/apikey. Leave blank to disable the
# voice feature; the mic button will show a clear "not configured" error.
GEMINI_API_KEY=
MODEL_LIVE=gemini-3.1-flash-live-preview
